RUSTFRP_DB=./data/rustfrp.db
RUSTFRP_HTTP=127.0.0.1:8080
RUSTFRP_EDGE=0.0.0.0:7000
RUSTFRP_PUBLIC_URL=https://frp.example.com
RUSTFRP_ALLOW_PORTS=20000-30000
RUSTFRP_AUDIT_RETENTION_DAYS=90
RUSTFRP_TRAFFIC_RETENTION_DAYS=7
RUSTFRP_CLEANUP_BATCH=500
RUSTFRP_PANEL_DIR=/opt/rustfrp/panel
RUSTFRP_SECURE_COOKIE=true
RUSTFRP_DOMAIN=frp.example.com
ACME_EMAIL=admin@example.com
RUSTFRP_UPSTREAM=127.0.0.1:8080
