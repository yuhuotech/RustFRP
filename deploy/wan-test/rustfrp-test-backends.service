[Unit]
Description=RustFRP isolated WAN test loopback backends
After=network.target

[Service]
User=rustfrp-test
Group=rustfrp-test
ExecStart=/usr/bin/python3 /opt/rustfrp-test/wan_backends.py /var/lib/rustfrp-test/backend-cert.pem /var/lib/rustfrp-test/backend-key.pem
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rustfrp-test

[Install]
WantedBy=multi-user.target
