{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustFRP",
  "mainBinaryName": "rustfrp_app",
  "version": "0.1.0",
  "identifier": "com.rustfrp.desktop",
  "build": { "frontendDist": "../rustfrp-ui/dist", "beforeBuildCommand": "node rustfrp-desktop/tools/package-agent.mjs" },
  "app": {
    "windows": [{ "label": "main", "create": false, "title": "RustFRP", "width": 1160, "height": 800, "minWidth": 390, "minHeight": 600 }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "nsis"],
    "resources": { "resources/": "." },
    "icon": ["../assets/brand/rustfrp-logo-32.png", "../assets/brand/rustfrp-logo-128.png", "../assets/brand/rustfrp-logo-256.png"]
  }
}
